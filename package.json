{
  "name": "hr-nexus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run typecheck && npm run build && npm run db:migrate:remote && wrangler deploy",
    "db:seed:test": "node scripts/seed-test-data.mjs",
    "db:seed:test:remote": "node scripts/seed-test-data.mjs --remote",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.7.11",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.38.0"
  }
}
